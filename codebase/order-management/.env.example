# Copy to .env (never commit .env). Docker Compose reads it automatically.
# Generate a real secret with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-bytes

USERS_DB_PASSWORD=users-dev-password
ORDERS_DB_PASSWORD=orders-dev-password

RABBITMQ_USER=oms
RABBITMQ_PASSWORD=oms-dev-password
